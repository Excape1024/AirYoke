<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="18dp" android:paddingBottom="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/panel_title" android:textColor="#86A4B7" android:textSize="13sp" />
        <ToggleButton android:background="@drawable/control_toggle" android:backgroundTint="@null" android:textColor="#DDEBE7" android:layout_margin="3dp" android:id="@+id/yokeEngaged" android:layout_width="104dp" android:layout_height="48dp" android:textOn="@string/yoke_on" android:textOff="@string/yoke_off" android:textSize="12sp" />
        <ToggleButton android:background="@drawable/control_toggle" android:backgroundTint="@null" android:textColor="#DDEBE7" android:layout_margin="3dp" android:id="@+id/throttleTakeover" android:layout_width="116dp" android:layout_height="48dp" android:textOn="@string/throttle_manual" android:textOff="@string/throttle_released" android:textSize="12sp" />
        <Button android:id="@+id/calibrateButton" android:layout_width="80dp" android:layout_height="48dp" android:text="@string/calibrate" android:backgroundTint="#24574F" android:textColor="#DDF7F0" android:textSize="12sp" />
        <Button android:id="@+id/settingsButton" android:layout_width="80dp" android:layout_height="48dp" android:text="@string/settings" android:backgroundTint="#263746" android:textColor="#DDE7EF" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:splitMotionEvents="true">
        <com.airyoke.ui.AxisSliderView android:id="@+id/throttleSlider" android:layout_width="126dp" android:layout_height="match_parent" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="8dp">
            <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center" android:textSize="12sp" android:textColor="#88CCBE" />
            <TextView android:id="@+id/flightText" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center" android:textSize="18sp" android:textColor="#E3EDF2" />
            <com.airyoke.ui.AttitudeIndicatorView android:id="@+id/attitudeIndicator" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <TextView android:id="@+id/feedbackText" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center" android:textSize="11sp" android:textColor="#9FAEBC" />
            <com.airyoke.ui.AxisSliderView android:id="@+id/rudderSlider" android:layout_width="match_parent" android:layout_height="58dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="120dp" android:layout_height="match_parent" android:orientation="vertical">
            <com.airyoke.ui.AxisSliderView android:id="@+id/spoilerSlider" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <ToggleButton android:background="@drawable/control_toggle" android:backgroundTint="@null" android:textColor="#DDEBE7" android:layout_margin="3dp" android:id="@+id/spoilerArm" android:layout_width="match_parent" android:layout_height="48dp" android:textOn="@string/spoilers_armed" android:textOff="@string/spoilers_disarmed" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="90dp" android:layout_height="match_parent" android:gravity="bottom" android:orientation="vertical" android:paddingHorizontal="4dp">
            <Button android:id="@+id/apDisconnectButton" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginBottom="8dp" android:text="@string/ap_disconnect" android:enabled="false" android:textSize="12sp" android:paddingHorizontal="2dp" android:backgroundTint="#8A3934" android:textColor="#FFF1ED" />
            <Button android:id="@+id/brakeButton" android:layout_width="match_parent" android:layout_height="132dp" android:text="@string/brake" android:textSize="17sp" android:backgroundTint="#315464" android:textColor="#E3EDF2" />
            <ToggleButton android:background="@drawable/control_toggle" android:backgroundTint="@null" android:textColor="#DDEBE7" android:layout_margin="3dp" android:id="@+id/parkingBrake" android:layout_width="match_parent" android:layout_height="56dp" android:textOn="@string/parking_on" android:textOff="@string/parking_off" android:textSize="12sp" />
        </LinearLayout>
        <com.airyoke.ui.AxisSliderView android:id="@+id/flapsSlider" android:layout_width="100dp" android:layout_height="match_parent" />
    </LinearLayout>
</LinearLayout>


